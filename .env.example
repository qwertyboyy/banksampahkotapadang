DB_HOST=
DB_USER=
DB_PASS=
DB_NAME=
PORT=5000
JWT_SECRET=
# Security: use a random JWT_SECRET of at least 32 bytes in production.
# Configure only the actual reverse proxy addresses (never trust all clients).
# TRUSTED_PROXIES=127.0.0.1,::1
TRANSFER_MAX_AMOUNT=1000000
TRANSFER_DAILY_LIMIT=5000000
TRANSFER_PENDING_LIMIT=5
# EMAIL_USER and EMAIL_PASS must work before enabling the updated admin login.

# OTP SMTP. From must be an address authorized by the selected SMTP provider.
SMTP_HOST=mail.padang.go.id
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=dislingkunganhidup@padang.go.id
# Enter a newly rotated SMTP password locally/on the VPS, never in chat or source control.
SMTP_PASS=
EMAIL_FROM_ADDRESS=dislingkunganhidup@padang.go.id
EMAIL_FROM_NAME="Dinas Lingkungan Hidup Kota Padang"
EMAIL_REPLY_TO=dislingkunganhidup@padang.go.id
# EMAIL_USER / EMAIL_PASS remain supported when SMTP_USER / SMTP_PASS are unset.

# Optional: path to the SMTP server CA PEM certificate if its chain is private.
# SMTP_CA_FILE=
